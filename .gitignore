# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
sweep.pid
settings.toml

# Evaluation output: heavy artefacts out, per-run summaries in.
# The directories themselves are re-included because git will not descend
# into an excluded directory, which would make the negations dead.
federated_evaluation_reports/**
!federated_evaluation_reports/**/
!federated_evaluation_reports/**/experiment_summary.json

# Pipeline 7'den kalan tek kol. Sürüm 8'de çeşitlilik çarpanı varsayılan olarak
# kapandığı için ablasyonun yönü tersine döndü ve bu kolun yerini
# `ablation-with-diversity` aldı. Özetleri hâlâ diskte ama v7 damgası taşıyor,
# yani PR-AUC değerleri geçersiz. Dışarıda kalmasının sebebi yer değil: yayımlanan
# ağaçta duran geçersiz bir kol, okuyanın ondan sayı türetmesine açık kapı bırakır.
federated_evaluation_reports/ablation-no-diversity__seed*/

centralized_evaluation_reports/**
!centralized_evaluation_reports/**/
!centralized_evaluation_reports/**/centralized_experiment_summary.json

